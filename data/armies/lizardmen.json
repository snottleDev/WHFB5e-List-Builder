  "rules": [
    {"type": "exactlyTag", "tag": "general", "count": 1, "message": "The army must include exactly one Slann Mage-Priest as General (p.73)."},
    {"type": "maxTag", "tag": "bsb", "count": 1, "message": "Only one Battle Standard is allowed (p.73)."},
    {
      "type": "perUnits",
      "entry": "temple-guard",
      "units": true,
      "max": 1,
      "per": ["slann-general", "slann", "lord-kroak", "mazdamundi"],
      "message": "One unit of Temple Guard for each Slann Mage-Priest (p.75)."
    },
    {
      "type": "perUnits",
      "entry": "terradons",
      "units": true,
      "max": 1,
      "atLeast": 1,
      "per": ["slann-general", "slann", "lord-kroak", "mazdamundi"],
      "message": "Up to one unit of Terradons for each Slann Mage-Priest, and always at least one (p.77)."
    },
    {
      "type": "perUnits",
      "entry": "stegadons",
      "max": 1,
      "per": ["temple-guard", "saurus", "skinks", "cold-one-riders"],
      "message": "As many Stegadons as there are units of Temple Guard, Saurus, Skinks and Cold One Riders (p.77)."
    },
    {"type": "perUnits", "entry": "salamanders", "max": 1, "per": ["saurus", "skinks"], "message": "As many Salamanders as there are units of Saurus and Skinks (p.78)."},
    {
      "type": "perUnits",
      "entry": "lizard-swarms",
      "model": "half",
      "max": 1,
      "per": ["temple-guard", "saurus", "skinks", "cold-one-riders"],
      "message": "Half-price Lizard Swarms: at most one per unit of Temple Guard, Saurus, Skinks or Cold One Riders; any more cost 100 points each (p.78)."
    },
    {
      "type": "perUnits",
      "entry": "serpent-swarms",
      "model": "half",
      "max": 1,
      "per": ["temple-guard", "saurus", "skinks", "cold-one-riders"],
      "message": "Half-price Serpent Swarms: at most one per unit of Temple Guard, Saurus, Skinks or Cold One Riders; any more cost 100 points each (p.78)."
    },
    {"type": "unitsBySize", "entries": ["kroxigor"], "per": 5, "message": "Up to five Kroxigor form one unit, 6-10 up to two units, and so on (p.77)."}
  ],
