  "entries": [
    {"id": "general", "name": "Dwarf General", "kind": "character", "category": "characters", "page": 83, "race": "dwarf", "cost": 160, "magicItems": 3, "profile": ["3", "7", "6", "4", "5", "3", "5", "4", "10"], "equipmentList": true, "equipmentText": "Hand weapon (an heirloom axe)", "rulesText": "Hate Orcs & Goblins, Elf grudge, Pursue/flee 2D6-1", "max": 1, "tags": ["general"], "options": [{"id": "throne", "name": "Throne of Power with four bearers (High King only)", "cost": 140, "extraProfile": {"name": "Throne bearer (4)", "profile": ["3", "5", "4", "4", "4", "1", "3", "2", "9"]}}], "notes": "A Lord: up to three magic items, from the Warhammer Magic cards or runic items made with the rules in this book. Only a General who is the High King may ride the Throne of Power (p.83)."},
    {"id": "battle-standard", "name": "Battle Standard Bearer", "kind": "character", "category": "characters", "page": 83, "race": "dwarf", "cost": 98, "magicItems": 1, "profile": ["3", "5", "4", "4", "4", "1", "3", "2", "9"], "equipmentList": true, "equipmentText": "Hand weapon and battle standard", "rulesText": "Hate Orcs & Goblins, Elf grudge, Pursue/flee 2D6-1", "max": 1, "tags": ["bsb"], "notes": "His one magic item may be a magic standard or a runic standard; runes of protection make the army's banner a magic standard. Master runes of protection may only go on this standard (pp.28, 83)."},
