    {"id": "runesmith", "name": "Runesmith", "kind": "character", "category": "characters", "page": 84, "race": "dwarf", "max": 1, "tags": ["runesmith"], "runesmith": true, "equipmentList": true, "equipmentText": "Axe, hammer or other hand weapon", "variantsLabel": "Rank", "variants": [{"id": "runesmith", "name": "Runesmith", "cost": 78, "magicItems": 3, "profile": ["3", "6", "4", "4", "5", "2", "3", "2", "9"]}, {"id": "master", "name": "Master Runesmith", "cost": 187, "magicItems": 3, "profile": ["3", "7", "5", "4", "6", "3", "4", "3", "10"]}, {"id": "rune-lord", "name": "Rune Lord", "cost": 306, "magicItems": 3, "profile": ["3", "8", "6", "5", "6", "4", "5", "4", "10"]}], "options": [{"id": "anvil", "name": "Anvil of Doom with two Anvil guards", "cost": 200, "extraProfile": {"name": "Anvil guard (2)", "profile": ["3", "5", "4", "4", "4", "1", "3", "2", "9"]}}], "rulesText": "Hate Orcs & Goblins, Elf grudge, Pursue/flee 2D6-1, Not a wizard", "notes": "Any Runesmith may carry up to three magic items. Anvil guards are Champions with heavy armour and double-handed hammers who stay within 4\" of the Anvil (p.84)."},
    {"id": "slayer-champion", "name": "Slayer Champion", "kind": "character", "category": "characters", "page": 84, "race": "slayer", "equipmentList": true, "equipmentText": "Axe (no armour)", "itemTypes": ["weapon"], "variantsLabel": "Kind", "variants": [{"id": "giant", "name": "Giant Slayer", "cost": 63, "magicItems": 1, "profile": ["3", "5", "4", "4", "4", "1", "3", "2", "9"], "rulesText": "Slayer skill up to S8"}, {"id": "dragon", "name": "Dragon Slayer", "cost": 136, "magicItems": 1, "profile": ["3", "6", "5", "4", "5", "2", "4", "3", "10"], "rulesText": "Slayer skill up to S9"}, {"id": "daemon", "name": "Daemon Slayer", "cost": 210, "magicItems": 1, "profile": ["3", "7", "6", "4", "5", "3", "5", "4", "10"], "rulesText": "Slayer skill up to S10"}], "attachTo": {"entries": ["slayers"], "label": "Fighting with", "required": true, "requiredMessage": "a Slayer Champion must fight with a unit of Slayers"}, "rulesText": "Hate Orcs & Goblins, Immune to psychology, Unbreakable", "notes": "A Slayer unit may include any number of Slayer Champions of any kind. Each may carry one magic weapon only (a card or a runic weapon) and wears no armour (p.84)."},
